  "tests": {
    "new": "5 public capture/archive cases +2 private arithmetic-overflow cases, both feature selections/OS:28 new executions in successful revalidation.",
    "ordering": "Public drafts frozen before production; private overflow drafts written before counter implementation. No old-source failing runtime or mutation probe claimed.",
    "scenarios": [
      "Exact prior depth-first component excluded order across punctuation/Unicode prefixes and reversed creation order; identical selected entries/fingerprint/archive",
      "1000 excluded entries allowed with positive max_files1;1001 refuses traversal without publishing checkpoint or changing prior artifact",
      "Exact7 byte content accepted across sibling directories,6 refuses; selected2files accepted,3 refuses across siblings",
      "Regular3byte payload plus4byte symlink target counts7 total; restore preserves target/payload",
      "Visited and content counter representable-overflow edges refuse with InvalidInput"
    ],
    "retained": "Full gate includes existing ignore/tracked-selection, linked Git, checkpoint/recovery/native/provider suites. Public bound tests alone do not prove allocation or accumulator timing."
  },
