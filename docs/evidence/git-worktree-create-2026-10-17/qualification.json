  "tests": {
    "new": "9 private creation unit tests and11 real Git/native cases pass under both feature selections on each OS;80 individual new-test executions total.",
    "scenarios": [
      "Exact pinned commit/new branch, dirty anchor retained, target path containing space/newline, rediscovery and explicit existing-provider attachment",
      "Terminal retry retains dirty target; changed request and wrong workspace refused",
      "Existing branch and nonempty target refuse without force/reset in tested cases",
      "Concurrent same-ID starts invoke one actual Git worktree add",
      "Native launch actually accepted before injected lost acknowledgement; identical retry invokes add once",
      "Canceled and execution-timed-out managed wrapper runs reconnect without invoking again; wrapper waits before Git creation, so this is not Git partial-checkout cancellation qualification",
      "Simulated Lost observation over a confirmed active native claim preserves sameRunRef and one invocation; actual native supervisor-loss tests remain separate existing provider_local coverage",
      "SHA256 forty-hex abbreviation, SHA1 sixty-four-hex named ref and annotated-tag-object peeling rejected before any add invocation, new branch/path or native claim",
      "Replacement ref proven effective in fixture, then SDK checkout uses original pinned commit contents while retaining replacement metadata"
    ],
    "retained": "Existing Git discovery tests and all native/provider/recovery/handoff/import/export suites pass unchanged in the full gate.",
    "test_method": "Disposable real Git repositories and native managed runs; forwarding backend seam loses the reply after real inner.start. Creation wrappers count only worktree add and delegate revision verification to Git. Held/cancellation cases use a controlled pre-Git process. All cases retain source/control storage through awaited native run cleanup.",
    "drafts": "Initial7 native cases and6 unit tests drafted before implementation; strict revision/replacement fixtures and3 verifier unit tests drafted before corresponding fixes. Harness corrections were source-reviewed before gate. No executed old-source failing or mutation probe is claimed."
  },
  "findings_and_fixes": [
    {
      "severity": "P2",
      "finding": "Full-looking hex strings can abbreviate a different hash format, resolve hex-named refs or peel annotated tags.",
      "fix": "Before managed launch, bounded successful exact-line rev-parse verification must resolve to the requested full commit ID. Replacement objects are disabled during verification and creation."
    },
    {
      "severity": "P2",
      "finding": "Raw Git can remove its in-progress target during failure/signal cleanup; no SDK rollback does not imply no Git cleanup.",
      "fix": "Contract requires trusted stable repository and exclusive quiescent destination control; documents Git cleanup/partial state, no SDK-issued reset/force/rollback and no transactional guarantee."
    },
    {
      "severity": "P2",
      "finding": "Draft test cleanup retained numeric process IDs that might be reused before delayed cleanup.",
      "fix": "Removed raw PID signaling entirely. Cleanup uses qualified native RunRef cancellation and independent terminal inspection."
    },
    {
      "severity": "P2",
      "finding": "Post-acknowledgement-only claim tracking and unguarded short tests could omit an uncertain launch when canceled or panicking.",
      "fix": "Every case has an outer retained fixture; intended native identities registered before awaiting start. Unexpected identities are not targeted; uncertainty/missing state/cleanup failure preserves control storage and fails. These failure-retention branches were source-reviewed, not asserted to have all been injected during the passing run."
    }
  ],
