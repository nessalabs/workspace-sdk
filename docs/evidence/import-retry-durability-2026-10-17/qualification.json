    "cargo test --locked --no-default-features",
    "RUSTDOCFLAGS=-Dwarnings cargo doc --locked --all-features --no-deps",
    "cargo build --locked --bin workspace-supervisor",
    "cargo test --locked --test runtime_performance -- --ignored --nocapture",
    "cargo test --locked --test runtime_pty_performance -- --ignored --nocapture"
  ],
  "tests": {
    "new": "9 private import tests executed twice per OS: all-features and no-default-features, all PASS",
    "method": "Real archive decoding, file/hard-link/symlink publication and atomic receipt persistence. Every uninjected PublicationStep executes its actual operation. Faults are returned before the selected sync syscall. No process-global failpoint.",
    "scenarios": [
      "Pending intent ancestry failure refuses before selected files, repeated matching retry then completion",
      "Nested file visible after failed ancestor sync remains Pending; retry must attempt failed boundary again before acknowledgement",
      "Complete selected-file sync error refuses without replacing its inode or changing receipt",
      "Complete receipt file sync failure refuses repeatedly before successful retry",
      "Actual Complete persist visible followed by metadata directory sync failure is not acknowledged; same retry finishes sync",
      "Nested retry parent ordering and canonical ancestry through filesystem root",
      "Empty selection still flushes root and receipt",
      "Dangling selected symlink flushes parent without opening link or target",
      "Changed partial file conflicts before syncing or overwriting"
    ],
    "retained": "Existing checkpoint_remote import/reexport, partial retry, malicious-path, new-only publication and scoped transfer-cleanup coverage passed unchanged in the full suites.",
    "drafts": "Eight initial tests were drafted independently before production implementation; parent drafted the ninth intent-ancestry test before that fix. Ordering assertions were corrected in source review before execution. No old-source red run or mutation probe is claimed."
  },
  "findings_and_fixes": [
    {
      "severity": "P2",
      "finding": "A published nested file can survive a sync error visibly, then matching Pending retry skips its durability work.",
      "fix": "Resync validated selected regular files and their parents before Complete persistence."
    },
    {
      "severity": "P2",
      "finding": "Visible Complete receipt can follow failed parent sync; fast retry acknowledged it without finishing durability.",
      "fix": "Complete retry revalidates and syncs selected files, receipt and canonical ancestry before acknowledgement."
    },
    {
      "severity": "P2",
      "finding": "Visible SDK metadata directory after interrupted creation can leave Pending intent ancestry uncertain before effects.",
      "fix": "Receipt save finishes canonical metadata-parent ancestry before selected-file publication and completion return."
    },
    {
      "severity": "P2",
      "finding": "Proposed deduplicating set copied all ancestor prefixes and could multiply memory for deep accepted paths.",
      "fix": "Walk each selected parent chain directly with one copied prefix at a time; accept repeated shared-parent sync calls."
    }
  ],
