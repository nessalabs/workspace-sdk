  "test_summary": {
    "ubuntu-24.04": {
      "linked_worktree_return_applies_selected_files_and_retries_without_changing_git_metadata": 2,
      "linked_worktree_return_requires_quiescence_and_unchanged_selected_destination": 2,
      "linked_worktree_return_conflicts_retain_both_sides_without_source_or_git_writes": 2
    },
    "macos-15": {
      "linked_worktree_return_applies_selected_files_and_retries_without_changing_git_metadata": 2,
      "linked_worktree_return_requires_quiescence_and_unchanged_selected_destination": 2,
      "linked_worktree_return_conflicts_retain_both_sides_without_source_or_git_writes": 2
    }
  },
  "tests": {
    "new": "3 real Git/filesystem public-flow tests, each feature selection on Ubuntu/macOS:12 new executions.",
    "flow": [
      "Real linked checkout with deliberately staged index bytes different from working-tree bytes, selected untracked file, ignored data and mandatory .env exclusion",
      "Capture working-tree base; export_checkpoint_archive; copy archive bytes to disposable local target transfer path; import_remote_tree persists selected_paths receipt",
      "Edit tracked-but-ignored file, delete tracked file, create selected target file; receipt-aware export_remote_tree and capture_archive retain selection",
      "Reconcile into original linked checkout, review without writes; explicit quiescent apply; exact retry after a later selected user edit preserves that edit; explicit rollback restores preapply working-tree bytes",
      "Nonquiescent and stale selected-destination apply refuse and remain NotStarted; divergent local/target conflict retains base/local/remote blobs and refuses apply/incomplete resolution acknowledgement"
    ],
    "metadata_oracle": "After deliberate Git staging, compare all regular-file bytes under main checkout including common repository refs/objects/logs and both indexes, plus linked .git pointer/excluded local bytes at every relevant phase. No Git status/diff commands after baseline.",
    "retained": "Existing healthy/broken linked capture, ignore/tracked policy, native process/recovery/provider and full checkpoint suites pass. No old-source red run or mutation probe performed for this test-only qualification."
  },
