  "tests": {
    "new": "Five real Git/filesystem integration cases and two marker unit cases, each feature selection on Ubuntu/macOS;28 new executions total.",
    "ordering": "Four integration and two marker unit drafts preceded implementation. Fifth target export regression followed source-review feedback. No old-source failing execution or mutation probe was performed.",
    "scenarios": [
      "Healthy linked .git pointer, committed force-added ignored files retained by capture/export, nested content restored and all original Git metadata/payload bytes unchanged",
      "Unavailable common metadata causes explicit capture and local tree archive export refusal, preserving source pointer/data/retained metadata",
      "Subdirectory capture/export refuses when broken Git marker is on ancestor",
      "Direct export_remote_tree helper refuses unavailable linked metadata before archive publication; not a provider transport/live remote test",
      "Marker tests cover ordinary no-marker, ancestor regular file/directory and dangling symlink"
    ]
  },
  "findings_and_fixes": [
    {
      "severity": "P2",
      "finding": "Every failed source Git probe previously became an empty tracked set. Unavailable linked common metadata could cause tracked ignored files to be silently omitted while capture/export reported success.",
      "fix": "Unexpected successful probe output refuses. Failure or exact non-worktree result examines root/ancestor .git markers using no-follow metadata; any entry refuses and non-NotFound I/O failures propagate. No marker preserves legacy plain scanning."
    }
  ],
