    "cargo fmt --all -- --check",
    "cargo clippy --locked --all-features --all-targets -- -D warnings",
    "cargo build --locked --all-features --example pty_live_probe",
    "cargo test --locked --all-features",
    "cargo build --locked --no-default-features --example pty_live_probe",
    "cargo test --locked --no-default-features",
    "RUSTDOCFLAGS=-Dwarnings cargo doc --locked --all-features --no-deps",
    "cargo build --locked --bin workspace-supervisor",
    "cargo test --locked --test runtime_performance -- --ignored --nocapture",
    "cargo test --locked --test runtime_pty_performance -- --ignored --nocapture"
  ],
  "new_tests": {
    "unit": 8,
    "real_git_native": 4,
    "execution_matrix": "Both feature selections on each of Ubuntu24.04/macOS15;16unit+8native executions per OS",
    "test_order": "Six unit tests and four native tests written before implementation; two additional boundary tests afterward. No original-source red execution or new mutation probe claimed."
  },
  "observed": [
    "Actual Git primary and linked anchors report spaces/newline paths, branch/detached state, lock reasons and reasonless locks, missing/prunable checkout, bare and unborn repositories.",
    "A preexisting linked checkout and a checkout created by an explicit Git command through Workspace::exec use the same discovery path.",
    "Explicit LocalOpenOptions attachments execute foreground and managed counter updates concurrently in distinct checkouts; primary counter and shared files remain unchanged, controls are distinct/outside all project roots.",
    "Discovered paths do not grant ownership: attachments remain Attached, destruction is Unsupported, and only explicit attachments enter existing SDK registry.",
    "Ordinary non-repository directories and unavailable Git executables return errors, not empty successful inventories.",
    "Unit tests reject failed/noexit/timedout/truncated otherwise-parseable results; complete output and exact acceptance limits are tested.",
    "Strict NUL parser rejects partial, duplicate, inconsistent, unknown, oversized or lossy metadata; SHA256-length IDs are synthetic parser coverage, not a real SHA256 repository qualification."
  ],
  "bounds": {
    "combined_stdout_stderr_acceptance_bytes": 262144,
    "records": 256,
    "path_bytes": 16384,
    "reason_and_reference_bytes": 4096,
    "command_requested_timeout_seconds": 10,
    "note": "Acceptance occurs after backend execution; existing capture/allocation and cancellation contracts remain. A requested process deadline is not a new transport-wide timeout."
  },
  "design": "Concrete GitWorktreeDiscovery reuses Workspace::exec and WorkspaceRef. No new provider port, registry, scheduler, persistence schema or worktree lifecycle journal. Shell-free argv clears inherited repository/inline-config redirects while retaining host global/system config and safe.directory.",
  "findings_and_fixes": [
    {
      "severity": "P2 test hygiene",
      "finding": "Per-command fixture hook suppression would not protect later SDK-executed Git worktree add from host-global checkout hooks",
      "resolution": "Persist fixture-local core.hooksPath=/dev/null and commit.gpgSign=false after init; both independent reviewers inspected delta before gate. Production configuration policy unchanged.",
      "evidence_kind": "Static source finding; no user hook was deliberately executed."
    }
  ],
