  "tests": {
    "new": "4 unit and12 real Git/native removal cases under both feature selections on each OS;64 new executions total.",
    "retained": "All11 creation cases preserved through shared fixture; creation, discovery, recovery and existing suites pass.",
    "boundaries": [
      "Success retry after replacement worktree creation preserves replacement; failed dirty removal retried after cleaning remains old failed run",
      "Changed request, wrong workspace and creation-run-ID reuse refuse",
      "Ordinary untracked files remain protected even with hidden-untracked host configuration; ignored files are intentionally deleted by ordinary Git",
      "Locked/main/unregistered/submodule targets refuse; anchor/control lexical containment refuses before launch",
      "Concurrent starts and actual lost start acknowledgement retain one native invocation",
      "Cancel/timeout use wrapper before actual Git removal; Lost observation simulated over a real native claim, not actual supervisor death"
    ]
  },
  "findings_and_fixes": [
    {
      "severity": "P2",
      "finding": "Ordinary non-force Git removal can delete ignored data and host configuration may hide ordinary untracked files.",
      "fix": "Explicit status.showUntrackedFiles=all and native regressions; public ignored-data deletion and partial-failure contract."
    },
    {
      "severity": "P2",
      "finding": "Removing anchor/control storage could destroy reconnect identity.",
      "fix": "Pure normalized descriptor containment guard; caller must maintain physical separation including aliases and common Git metadata."
    }
  ],
